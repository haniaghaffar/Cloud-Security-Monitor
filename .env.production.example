# Production values are configured in the GitHub "production" environment.
# Set the real HTTPS backend URL, public Entra IDs, and backend API scope there.
VITE_API_BASE_URL=
VITE_AUTH_CLIENT_ID=
VITE_AUTH_TENANT_ID=
# Delegated permission exposed by Member 1's backend API.
VITE_AUTH_API_SCOPE=
# Optional; defaults to the deployed Static Web App origin.
VITE_AUTH_REDIRECT_URI=
