# Cloud Security Monitor — Frontend Environment Variables
# Microsoft Azure Backend & Microsoft Entra ID Integration Template
# Safe configuration placeholders only — NEVER put client secrets, private keys, or access tokens here.

# Microsoft Azure REST API Gateway / Functions Base URL (Member 1)
# Example: https://csm-api-prod.azurewebsites.net/api
VITE_API_BASE_URL=

# Microsoft Entra ID (Azure AD) Single-Page Application Authentication
# Public Application (Client) ID registered in Microsoft Entra ID
VITE_AUTH_CLIENT_ID=

# Microsoft Entra ID Directory (Tenant) ID or 'common'
VITE_AUTH_TENANT_ID=

# Delegated permission exposed by Member 1's backend API.
# Example shape: api://<backend-app-id>/<scope-name>
VITE_AUTH_API_SCOPE=

# Optional: Custom Redirect URI (defaults to window.location.origin)
# Example: http://localhost:5173
VITE_AUTH_REDIRECT_URI=
