# Copy the needed values to .env.development.local for local development.
# Leave the API URL blank until Member 1 provides the real backend endpoint.
VITE_API_BASE_URL=
VITE_AUTH_CLIENT_ID=
VITE_AUTH_TENANT_ID=
# Set only after Member 1 provides the backend's delegated API scope.
VITE_AUTH_API_SCOPE=
VITE_AUTH_REDIRECT_URI=http://localhost:5173
